# DhanPay Environment Configuration Example
# Copy to .env and replace secrets before running in non-local environments.

# Server
SERVER_PORT=8080

# MySQL 8.0
DB_PORT=3306
DB_NAME=dhanpay
DB_USERNAME=dhanpay_app
DB_PASSWORD=dhanpay_secret
DB_ROOT_PASSWORD=dhanpay_root_secret
DB_URL=jdbc:mysql://localhost:3306/dhanpay?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# JWT Authentication (minimum 256-bit secret)
JWT_SECRET=4d687a59324b706e5837725439714c35624e386d46326a51775a3476635870394b366852336d5738795432664e376251
JWT_EXPIRATION_MS=86400000

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api
